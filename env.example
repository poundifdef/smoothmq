# SmoothMQ Environment Variables
# Copy this file to .env and update with your actual values
# cp env.example .env

# SQS Authentication Keys
# These are used for AWS Signature Version 4 authentication
DEV_ACCESS_KEY_ID=your_access_key_here
DEV_SECRET_ACCESS_KEY=your_secret_key_here

# SQS Keys Configuration
# Format: "access_key:secret_key" or "key1:secret1,key2:secret2" for multiple keys
# You can set this directly, or let docker-compose build it from the variables above.
# Q_SQS_KEYS=your_access_key_here:your_secret_key_here

# Dashboard Authentication
# Username and password for the web dashboard Basic Auth
Q_DASHBOARD_USER=admin
Q_DASHBOARD_PASS=change_me_secure_password

# Persistence
# SQLite database path
Q_SQLITE_PATH=/app/data/smoothmq.sqlite

